# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# GitHub Actions integration (server-side only)
GH_TOKEN=
GH_OWNER=
GH_REF=main

# Bridge administration and optional cron authentication (server-side only)
BRIDGE_ADMIN_PASSWORD=
BRIDGE_CRON_SECRET=
BRIDGE_CRON_SECRET_PREVIOUS=

# Optional direct PostgreSQL URL for Drizzle CLI commands (server-side only)
DATABASE_URL=

# Precision Lab Observer (server-to-server only; never expose to LLM clients)
OBSERVER_BASE_URL=https://precision-lab-readonly-api.onrender.com
OBSERVER_SERVICE_KEY=

# Explicit opt-in required before Bridge dispatches repo-command workflows.
BRIDGE_COMMAND_EXECUTION_ENABLED=false

# TCA-1 Function Calling gateway (server-side only; never expose to LLM prompts)
TCA1_BRIDGE_BASE_URL=
TCA1_BRIDGE_KEY=
TCA1_ACCESS_MODE=read
TCA1_HTTP_TIMEOUT_MS=10000
TCA1_FUNCTION_GATEWAY_TOKEN=
